{{!-- What the Warden found and sent to the party, as its body: the message's `flavor` names the
      party and is the caption. The lines are the barter card's, which are the store card's — the
      same kind of record. It lists what landed then, and is not a view of the Stash: the button
      opens the party on its Stash for whoever may see it (`module/treasure.js` wires it). --}}
<ul class="cairn-store-card-lines">
    {{#each items}}
    <li><span>{{this}}</span></li>
    {{/each}}
    {{#if coin}}
    <li><span>{{coin}} {{localize "CAIRN.GoldAbbrev"}}</span></li>
    {{/if}}
</ul>
<button type="button" class="cairn-card-action cairn-treasure-open">
    <i class="fa-solid fa-sack-dollar" inert></i>{{localize "CAIRN.Treasure.OpenStash"}}
</button>
