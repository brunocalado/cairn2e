{{!-- A live `<prose-mirror>`, not the `{{editor}}` helper: the helper emits appv1 markup that
      nothing in the v2 framework activates, so the pencil it drew opened nothing (see
      `templates/item/tab-description.hbs` for the whole finding). `toggled`, with the enriched
      HTML as its content, so it reads as text — links live — until its pencil is pressed, and
      leaving the field saves and closes it. --}}
<section class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
    <div class="cairn-prose-box" data-ink="box" data-ink-seed="npc-description" data-ink-w="1.6">
        <prose-mirror name="system.description" value="{{system.description}}" toggled
            data-document-uuid="{{actor.uuid}}" {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror>
    </div>
</section>
