{{!-- *Petty* items: with the character, and weighing nothing. "*Petty* items do not take up any
      slots" (`srd-2e/players-guide/character-creation.md`), so they are on the person but never
      on the ten ruled lines — which is the whole reason they need a face of their own. A scroll
      is *petty* by rule, so this is the only place on a character's sheet one is ever drawn.

      The tab holds two zones, because 2e defines *petty* by weight and a claw weighs the same:
      Body first — fists, claws, a bite, a metal arm on its shoulder (`system.bodily`), what the
      character attacks with and never carries, read in the same breath as the weapons in hand —
      then the things in a pocket. Every character is born with Unarmed in Body
      (`documents/actor.js#_preCreate`), an ordinary gear the player may rename or re-die. Each
      zone has its own heading and its own add control; Body's makes the new thing bodily
      (`_item-prompt.js`). --}}
<section class="tab {{tabs.petty.cssClass}}" data-group="primary" data-tab="petty">
    <div class="cairn-zone-head">
        <h4 class="cairn-zone">{{localize 'CAIRN.Body'}}</h4>
        {{#if editable}}
        <a class="cairn-zone-add" data-action="bodyCreate">
            <i class="fas fa-plus" inert></i><span>{{localize 'CAIRN.Add'}}</span>
        </a>
        {{/if}}
    </div>
    <div class="cairn-zone-rule" data-ink="hline" data-ink-seed="zone-body" data-ink-w="1" data-ink-a="0.34"></div>
    {{> "systems/cairn2e/templates/parts/plain-list.hbs" rows=inventory.body seed="body"
        empty=(localize 'CAIRN.NoBody') inBody=true}}

    <div class="cairn-zone-head">
        <h4 class="cairn-zone">{{localize 'CAIRN.PettyItems'}}</h4>
        {{#if editable}}
        <a class="cairn-zone-add" data-action="pettyCreate">
            <i class="fas fa-plus" inert></i><span>{{localize 'CAIRN.Add'}}</span>
        </a>
        {{/if}}
    </div>
    <div class="cairn-zone-rule" data-ink="hline" data-ink-seed="zone-petty" data-ink-w="1" data-ink-a="0.34"></div>
    {{> "systems/cairn2e/templates/parts/plain-list.hbs" rows=inventory.petty seed="petty"
        empty=(localize 'CAIRN.NoPettyItems')}}
</section>
