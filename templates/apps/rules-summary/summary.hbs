                <li>{{{localize "CAIRN.RulesRef.Hp.Scars"}}}</li>
            </ul>
        </section>
        <section class="cairn-rules-section">
            <h3 class="cairn-rules-head" data-ink="hline" data-ink-seed="rules-healing" data-ink-w="1.8" data-ink-at="bottom">{{localize "CAIRN.RulesRef.Healing.Title"}}</h3>
