{{!-- The rules a player reaches for at the table, from `srd-2e/` and nothing else: the
      Warden's procedures, tables and NPCs stay out. Three columns in reading order, the way the
      published summary lays them out; the grid folds to fewer as the window narrows. The strings
      carry their own <strong>/<em>, so they are drawn with triple braces — they are this
      system's own en.json, never anyone's input. --}}
<div class="cairn-rules-body">
    <div class="cairn-rules-col">
        <section class="cairn-rules-section">
            <h3 class="cairn-rules-head" data-ink="hline" data-ink-seed="rules-attributes" data-ink-w="1.8" data-ink-at="bottom">{{localize "CAIRN.RulesRef.Attributes.Title"}}</h3>
            <ul class="cairn-rules-list">
                <li>{{{localize "CAIRN.RulesRef.Attributes.Str"}}}</li>
                <li>{{{localize "CAIRN.RulesRef.Attributes.Dex"}}}</li>
                <li>{{{localize "CAIRN.RulesRef.Attributes.Wil"}}}</li>
                <li>{{{localize "CAIRN.RulesRef.Attributes.Outside"}}}</li>
                <li>{{{localize "CAIRN.RulesRef.Attributes.Zero"}}}</li>
            </ul>
        </section>
        <section class="cairn-rules-section">
            <h3 class="cairn-rules-head" data-ink="hline" data-ink-seed="rules-saves" data-ink-w="1.8" data-ink-at="bottom">{{localize "CAIRN.RulesRef.Saves.Title"}}</h3>
            <ul class="cairn-rules-list">
                <li>{{{localize "CAIRN.RulesRef.Saves.Roll"}}}</li>
