{{!-- What the character can hand over: every gear they own that is not inside something, and
      under a container what is in it, indented. One list row each (Primitive 7). A picked row is
      ringed in ink, the way a thing is marked on a paper list — a drawn box in place of the
      row's rule, and its name in full ink; never a hue, never a checkbox. What goes with a
      picked container is in full ink too, unringed: it is not a choice of its own. A sack of coin
      is never picked on its own, because coin goes by the amount below. A row that cannot go is
      faint and says why in its tooltip. --}}
<section class="cairn-barter-items">
    <h3 class="cairn-edit-group" data-ink="hline" data-ink-seed="barter-give" data-ink-w="1.8" data-ink-at="bottom">
        {{localize "CAIRN.Barter.Give"}}
    </h3>
    <ol class="cairn-plain-list cairn-barter-list">
        {{#each rows as |row|}}
        <li class="cairn-slot cairn-barter-row{{#if row.picked}} selected{{/if}}{{#if row.inside}} is-inside{{/if}}{{#if row.locked}} is-locked{{/if}}{{#if row.ringed}} is-ringed{{/if}}"
            {{#unless row.locked}}data-action="barterPick" role="button"{{/unless}} data-id="{{row.id}}"
            aria-pressed="{{#if row.picked}}true{{else}}false{{/if}}"
            {{#if row.reason}}data-tooltip-text="{{row.reason}}"{{/if}}
            {{#if row.ringed}}data-ink="box" data-ink-seed="barter-pick-{{row.id}}" data-ink-w="1.6"
            {{else if row.rule}}data-ink="hline" data-ink-seed="barter-row-{{row.id}}" data-ink-w="0.9" data-ink-a="0.42" data-ink-at="bottom"{{/if}}>
            <img class="cairn-actions-glyph" src="{{row.img}}" alt="" />
            <span class="cairn-item-title">{{row.name}}</span>
            {{#if row.setAside}}<span class="cairn-item-tag">{{localize "CAIRN.Barter.SetAside"}}</span>{{/if}}
        </li>
        {{else}}
        <li class="cairn-empty">{{localize "CAIRN.Barter.NothingToGive"}}</li>
        {{/each}}
    </ol>
</section>
