{{!-- Three sections in the SRD's order — Bond, then Age, then (for the youngest) an Omen —
      each under the heading-with-roll the Attributes step uses, so the two roll-driven steps
      read alike. The Omen roll and field are inert, not hidden, until Youngest is on: everything on a
      step is on screen from the first visit. --}}
<section class="tab creator-step {{tab.cssClass}}" data-group="primary" data-tab="bond">
    <div class="step-heading" data-ink="hline" data-ink-seed="step-bond" data-ink-w="1.8" data-ink-at="bottom">
        <h3>{{localize "CAIRN.Bond"}}</h3>
        <button type="button" class="mini" data-action="rollBond">
            <i class="fas fa-dice-d20"></i> {{localize "CAIRN.CharacterCreator.RollBond"}}
        </button>
    </div>
    {{!-- The roll fills the field and the field is the answer, as the Name step's is: rolled,
          rolled and reworded, or written from nothing, it is what the character keeps. Left
          blank, it is rolled on create. --}}
    <textarea class="cairn-edit-text creator-text" name="bond" rows="3" maxlength="{{limits.text}}"
        placeholder="{{localize 'CAIRN.CharacterCreator.BondPlaceholder'}}"
        data-ink="box" data-ink-seed="creator-bond" data-ink-w="1.6">{{bondText}}</textarea>
    {{!-- What the drawn Bond hands over, as the inventory's rows. They go with the draw, not with
          the words above: rewording the Bond keeps them, a new roll replaces them, and the × strikes
          one off. --}}
    {{#if bondGrants.length}}
    <div class="creator-bond-grants">
        <h4>{{localize "CAIRN.CharacterCreator.BondGrants"}}</h4>
        <ol class="cairn-plain-list">
            {{#each bondGrants as |grant|}}
            <li class="cairn-slot"
                {{#unless @last}}data-ink="hline" data-ink-seed="bond-grant-{{@index}}" data-ink-w="0.9" data-ink-a="0.42" data-ink-at="bottom"{{/unless}}>
                <span class="cairn-item-name-and-tags">
                    <span class="cairn-item-title{{#unless grant.ok}} cairn-broken{{/unless}}">{{grant.name}}</span>
                </span>
                <span class="cairn-item-controls">
                    <a data-action="dropBondGrant" data-index="{{grant.index}}" data-tooltip="{{localize 'CAIRN.CharacterCreator.DropBondGrant'}}"><i class="fas fa-xmark"></i></a>
                </span>
            </li>
            {{/each}}
        </ol>
    </div>
    {{/if}}

    <div class="step-heading" data-ink="hline" data-ink-seed="step-age" data-ink-w="1.8" data-ink-at="bottom">
        <h3>{{localize "CAIRN.CharacterCreator.Age"}}</h3>
        <button type="button" class="mini" data-action="rollAge">
            <i class="fas fa-dice"></i> {{localize "CAIRN.CharacterCreator.RollAge"}}
        </button>
    </div>
    {{!-- `name="age"` is unchanged: the change listener in `_onRender` reads it. --}}
    <label class="age-field">
        <span>{{localize "CAIRN.CharacterCreator.Age"}}</span>
        <input type="number" name="age" value="{{draft.age}}" min="0" />
        <span class="unit">{{localize "CAIRN.CharacterCreator.Years"}}</span>
    </label>
    {{!-- The switch is the system's one on/off control; `name="youngest"` is unchanged, so the
          change listener in `_onRender` keeps working; the label points at the pill. --}}
    <div class="section-controls">
        {{> "systems/cairn2e/templates/parts/toggle.hbs" field="youngest" value=draft.youngest id="creator-youngest"}}
        <label for="creator-youngest">{{localize "CAIRN.CharacterCreator.Youngest"}}</label>
    </div>

    <div class="step-heading" data-ink="hline" data-ink-seed="step-omen" data-ink-w="1.8" data-ink-at="bottom">
        <h3>{{localize "CAIRN.Omen"}}</h3>
        <button type="button" class="mini" data-action="rollOmen" {{#unless draft.youngest}}disabled{{/unless}}>
            <i class="fas fa-dice-d20"></i> {{localize "CAIRN.CharacterCreator.RollOmen"}}
        </button>
    </div>
    <textarea class="cairn-edit-text creator-text" name="omen" rows="3" maxlength="{{limits.text}}"
        placeholder="{{localize 'CAIRN.CharacterCreator.OmenPlaceholder'}}"
        data-ink="box" data-ink-seed="creator-omen" data-ink-w="1.6"
        {{#unless draft.youngest}}disabled{{/unless}}>{{omenText}}</textarea>
</section>
