{{!-- The hazard chosen above (`pick.hbs`). Every word here is for the Warden. Each hazard says the
      same four things in the same order — what it covers, the ladder with one example per step,
      whether it repeats, whether a save avoids it. A step's button IS the roll: one click, d4 to
      d10 of STR damage against the targets. Fatal has no button, on purpose — STR to 0 on the
      sheet is one edit, and a button that kills is too easy to press. A save button rolls nothing:
      it posts a card the players roll from. All three are on every hazard, with no default among
      them, because the attribute follows what the character does; the help mark beside each says
      what it usually covers here. --}}
<div class="cairn-hazards-body">
    <div class="cairn-hazards-about" data-ink="hline" data-ink-seed="hazards-about" data-ink-w="1.8" data-ink-at="bottom">
        <p>{{summary}}</p>
        <p class="cairn-hazards-repeats">{{repeats}}</p>
    </div>

    <ol class="cairn-plain-list cairn-hazards-steps" data-ink="hline" data-ink-seed="hazards-steps" data-ink-w="1.8" data-ink-at="bottom">
        {{#each steps as |s|}}
        <li class="cairn-hazards-row"
            {{#unless @last}}data-ink="hline" data-ink-seed="hazards-step-{{@index}}" data-ink-w="0.9" data-ink-a="0.42" data-ink-at="bottom"{{/unless}}>
            <span class="cairn-hazards-label">{{s.label}}</span>
            <span class="cairn-hazards-example">{{s.example}}</span>
            {{#if s.die}}
            <button type="button" class="cairn-hazards-die" data-action="rollStep" data-step="{{s.id}}">{{s.die}}</button>
            {{/if}}
        </li>
        {{/each}}
    </ol>

    <section class="cairn-hazards-save" data-ink="hline" data-ink-seed="hazards-save" data-ink-w="1.8" data-ink-at="bottom">
        <h4 class="cairn-hazards-label">{{localize "CAIRN.Hazards.SaveLabel"}}</h4>
        <p>{{localize "CAIRN.Hazards.SaveRule"}}</p>
        <div class="cairn-hazards-saves">
            {{#each saves as |v|}}
            <span class="cairn-hazards-ask">
                <button type="button" data-action="askSave" data-key="{{v.key}}">{{v.label}}</button>
                {{> "systems/cairn2e/templates/parts/help-mark.hbs" tip=v.tip label=v.help seed=(concat "hazards-save-" v.key)}}
            </span>
            {{/each}}
        </div>
    </section>

    <p class="cairn-hazards-principle" data-ink="box" data-ink-seed="hazards-principle" data-ink-w="1.6">{{localize "CAIRN.Hazards.Principle"}}</p>
</div>
