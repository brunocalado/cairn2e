{{!-- The hazard chosen above (`pick.hbs`). Each says the same four things in the same order —
      what it covers, the ladder with one example per step, whether it repeats, whether a save
      avoids it. A step's button IS the roll: one click,
      d4 to d10 of STR damage against the targets. Fatal has no button, on purpose — STR to 0 on
      the sheet is one edit, and a button that kills is too easy to press. The three saves are on
      every hazard, with no default among them: the attribute follows what the character does. --}}
<div class="cairn-hazards-body">
    <div class="cairn-hazards-about" data-ink="hline" data-ink-seed="hazards-about" data-ink-w="1.8" data-ink-at="bottom">
        <p>{{summary}}</p>
        <p class="cairn-hazards-repeats">{{repeats}}</p>
    </div>

    <ol class="cairn-plain-list cairn-hazards-steps" data-ink="hline" data-ink-seed="hazards-steps" data-ink-w="1.8" data-ink-at="bottom">
        {{#each steps as |s|}}
        <li class="cairn-hazards-row"
            {{#unless @last}}data-ink="hline" data-ink-seed="hazards-step-{{@index}}" data-ink-w="0.9" data-ink-a="0.42" data-ink-at="bottom"{{/unless}}>
            <span class="cairn-hazards-label">{{s.label}}</span>
            <span class="cairn-hazards-example">{{s.example}}</span>
            {{#if s.die}}
            <button type="button" class="cairn-hazards-die" data-action="rollStep" data-step="{{s.id}}">{{s.die}}</button>
            {{/if}}
        </li>
        {{/each}}
    </ol>

    <div class="cairn-hazards-row cairn-hazards-save" data-ink="hline" data-ink-seed="hazards-save" data-ink-w="1.8" data-ink-at="bottom">
        <span class="cairn-hazards-label">{{localize "CAIRN.Hazards.SaveLabel"}}</span>
        <div class="cairn-hazards-example">
            <p>{{localize "CAIRN.Hazards.SaveRule"}}</p>
            <p class="cairn-hazards-hint">{{saveHint}}</p>
            <div class="cairn-hazards-saves">
                {{#each saves as |v|}}
                <button type="button" data-action="rollSave" data-key="{{v.key}}">{{v.label}}</button>
                {{/each}}
            </div>
        </div>
    </div>

    <footer class="cairn-hazards-foot">
        <p>{{localize "CAIRN.Hazards.Principle"}}</p>
        <p>{{localize "CAIRN.Hazards.HouseRule"}}</p>
    </footer>
</div>
