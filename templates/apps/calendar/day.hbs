{{!-- The selected day: its date and where it falls. The scroller under it is the window's one
      place that can outgrow its content. --}}
<section class="cairn-calendar-detail">
    <div class="cairn-calendar-detail-title">
        <span class="cairn-calendar-detail-date">{{detail.date}}</span>
        <span class="cairn-calendar-sub">{{detail.sub}}</span>
    </div>
    <div class="cairn-calendar-notes"></div>
</section>
