{{!-- Today, the watch and the Warden's clock (module/apps/calendar.js).

      The date line never wraps. Beside it is the time: a player reads it, the Warden types it. The
      Warden's Show to players is on the title bar. The dial is a picture of the date, midnight to
      midnight: three watches in their colours, Night in two pieces either side of the day (`span`,
      each piece's hours, is its width), the lit one filled, a needle at the exact time (`--at`,
      the share of the day since midnight). Its segments are the Warden's watch control; a
      player's are disabled. They carry no tooltip: the word and the glyph already say which watch
      it is.

      The Warden sets the hour by dragging the needle by its head, in steps of the snap; the date
      never moves with it. Under the dial, the toolbar: the year being looked at and Go to today
      for everyone, then the Warden's date controls — a day back or on, Set as today for the
      selected day — and the snap. During a journey the needle stays put, the Warden's controls
      are off and the hint under them says why. --}}
<section class="cairn-calendar-head" data-ink="hline" data-ink-at="bottom" data-ink-seed="calendar-head" data-ink-w="2">
    <div class="cairn-calendar-today">
        <div class="cairn-calendar-today-text">
            <h2 class="cairn-calendar-date">{{today.date}}</h2>
            <p class="cairn-calendar-sub">{{today.sub}}</p>
        </div>
        {{#if isGM}}
        <input type="text" name="time" class="cairn-calendar-time" value="{{time}}" aria-label="{{localize 'CAIRN.Calendar.TimeOfDay'}}"
               {{#if journeying}}disabled{{/if}}>
        {{else}}
        <span class="cairn-calendar-time">{{time}}</span>
        {{/if}}
    </div>

    <div class="cairn-calendar-dial" style="--at: {{needle}}%">
        <div class="cairn-calendar-watches">
            {{#each watches}}
            <button type="button" class="cairn-calendar-watch{{#if lit}} lit{{/if}}" data-action="pickWatch" data-watch="{{index}}"
                    style="--span: {{span}}" aria-label="{{hint}}" {{#unless ../isGM}}disabled{{/unless}}>
                {{> "systems/cairn2e/templates/parts/watch-glyph.hbs" key=key}}
                {{#if named}}<span class="cairn-calendar-watch-name">{{watch}}</span>{{/if}}
            </button>
            {{/each}}
            {{#if canDrag}}
            <span class="cairn-calendar-needle grab" aria-label="{{localize 'CAIRN.Calendar.DragTime'}}"></span>
            {{else}}
            <span class="cairn-calendar-needle" aria-hidden="true"></span>
            {{/if}}
        </div>
        <div class="cairn-calendar-ticks" aria-hidden="true">
            {{#each ticks}}<span style="--at: {{at}}%">{{label}}</span>{{/each}}
        </div>
    </div>

    <div class="cairn-calendar-toolbar">
        <div class="cairn-calendar-stepper">
            <button type="button" class="cairn-calendar-arrow" data-action="viewYear" data-delta="-1" aria-label="{{localize 'CAIRN.Calendar.PreviousYear'}}"><i class="fa-solid fa-chevron-left" inert></i></button>
            <input type="number" name="year" min="0" step="1" value="{{view.year}}" aria-label="{{localize 'CAIRN.Calendar.Year'}}">
            <button type="button" class="cairn-calendar-arrow" data-action="viewYear" data-delta="1" aria-label="{{localize 'CAIRN.Calendar.NextYear'}}"><i class="fa-solid fa-chevron-right" inert></i></button>
        </div>
        <button type="button" class="cairn-calendar-goto" data-action="viewToday">{{localize "CAIRN.Calendar.GoToToday"}}</button>
        {{#if isGM}}
        <div class="cairn-calendar-segments" role="group" aria-label="{{localize 'CAIRN.Calendar.Day'}}">
            <button type="button" data-action="shiftDay" data-days="-1" aria-label="{{localize 'CAIRN.Calendar.DayBackHint'}}"
                    {{#if journeying}}disabled{{/if}}>{{localize "CAIRN.Calendar.DayBack"}}</button>
            <button type="button" data-action="shiftDay" data-days="1" aria-label="{{localize 'CAIRN.Calendar.DayOnHint'}}"
                    {{#if journeying}}disabled{{/if}}>{{localize "CAIRN.Calendar.DayOn"}}</button>
        </div>
        <button type="button" class="cairn-calendar-goto" data-action="setToday" {{#if setTodayOff}}disabled{{/if}}>
            {{localize "CAIRN.Calendar.SetToday"}}
        </button>
        <div class="cairn-calendar-snap">
            <span class="cairn-calendar-snaplabel">{{localize "CAIRN.Calendar.Snap"}}</span>
            <div class="cairn-calendar-segments" role="group" aria-label="{{localize 'CAIRN.Calendar.Snap'}}">
                {{#each snaps}}
                <button type="button" class="{{#if active}}active{{/if}}" data-action="pickSnap" data-minutes="{{minutes}}"
                        aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#if ../journeying}}disabled{{/if}}>{{label}}</button>
                {{/each}}
            </div>
        </div>
        {{/if}}
    </div>
    {{#if isGM}}{{#if journeying}}<p class="cairn-calendar-hint">{{journeyHint}}</p>{{/if}}{{/if}}
</section>
