{{!-- The combat tracker's list, in two blocks.

      2e's round is side-based (`core-rules.md` → Combat): every able PC acts, then their
      opponents, and the results resolve simultaneously. There is no initiative and no
      per-combatant turn, so core's `token-initiative` column — a number nobody can read and a
      roll button for a roll 2e does not make — is replaced by a control the row's owner ticks
      once that combatant has acted.

      One `<ol>`, with the side headings as rows inside it rather than as `<h3>`s between two
      lists: a render part must produce exactly ONE top-level element or the Handlebars mixin
      throws, and `<li>` is the only child an `<ol>` may legally take.

      The element classes are core's own (`combatant`, `token-image`, `token-name`,
      `combatant-controls`, `token-resource`) so the sidebar's layout still applies; only the last
      column and the grouping are this system's.

      A dungeon exploration draws its own rows instead (`combat-tracker-dungeon.hbs`), picked
      here rather than by swapping the part's template: core decides which combat the tracker
      views only AFTER the parts are configured (`CombatTracker#_configureRenderOptions`), so a
      swap made there would draw the combat that was on screen before. --}}
<ol class="combat-tracker plain">
    {{#if dungeon}}
    {{> "systems/cairn2e/templates/apps/combat-tracker-dungeon.hbs"}}
    {{else}}
    {{#each sides as |rows side|}}
        <li class="cairn-combat-side {{#if (eq @root.activeSide side)}}is-active{{/if}}">
            {{localize (concat "CAIRN.Combat.Side." side)}}
        </li>

        {{#each rows}}
            <li class="combatant {{css}} {{#if resolved}}is-resolved{{/if}} {{#if panicked}}is-panicked{{/if}} {{#if deprived}}is-deprived{{/if}}"
                data-combatant-id="{{id}}" data-action="activateCombatant">

                <img class="token-image" src="{{img}}" alt="{{name}}" loading="lazy">

                {{!-- One grid, as an exploration row is: the name, this round's distance and the
                      undo on the first line, the controls and effects under them. The undo's
                      20px slot is kept when empty, so every row's distance sits in one column. --}}
                <div class="token-name cairn-combat-body">
                    <strong class="name" data-tooltip-text="{{name}}">{{name}}</strong>

                    {{!-- One move is free and a second spends the action (`core-rules.md` →
                          Combat): the pace is a hue, and past the first move a glyph as well. --}}
                    <span class="cairn-combat-moved {{#if pace}}is-{{pace}}{{/if}}" data-tooltip
                          aria-label="{{localize paceLabel}}">
                        {{#if beyond}}<i class="fa-solid fa-person-running" inert></i>{{/if}}{{moved}}&nbsp;{{units}}
                    </span>

                    {{!-- Back to where the token stood when the round began, for whoever owns it. --}}
                    <span class="cairn-combat-slot is-undo">
                        {{#if canRevert}}
                            <button type="button" class="inline-control combatant-control icon fa-solid fa-rotate-left"
                                    data-action="revertMovement" data-tooltip
                                    aria-label="{{localize "CAIRN.Combat.RevertMovement"}}"></button>
                        {{/if}}
                    </span>

                    <div class="combatant-controls">
                        {{#if @root.user.isGM}}
                            <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                                    data-action="toggleHidden" data-tooltip
                                    aria-label="{{localize (ifThen hidden "COMBATANT.Show" "COMBATANT.Hide")}}"></button>
                            <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                                    data-action="toggleDefeated" data-tooltip
                                    aria-label="{{localize (ifThen isDefeated "COMBATANT.UnmarkDefeated" "COMBATANT.MarkDefeated")}}"></button>
                        {{/if}}
                        {{!-- Ping and pan are seldom used, so they show only under the pointer or
                              the keyboard (`.is-locate`), and in plainer glyphs than core's. --}}
                        {{#if canPing}}
                            <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye is-locate"
                                    data-action="pingCombatant" data-tooltip
                                    aria-label="{{localize "COMBATANT.Ping"}}"></button>
                        {{/if}}
                        {{#unless @root.user.isGM}}
                            <button type="button" class="inline-control combatant-control icon fa-solid fa-location-crosshairs is-locate"
                                    data-action="panToCombatant" data-tooltip
                                    aria-label="{{localize "COMBATANT.PanTo"}}"></button>
                        {{/unless}}
                        <div class="token-effects" data-tooltip-html="{{effects.tooltip}}">
                            {{#each effects.icons}}
                                <img class="token-effect" src="{{img}}" alt="{{name}}">
                            {{/each}}
                        </div>
                    </div>
                </div>

                {{#if resource includeZero=true}}
                    <div class="token-resource">
                        <span class="resource">{{resource}}</span>
                    </div>
                {{/if}}

                {{!-- The first-round DEX save: "each PC must make a DEX save in order to act"
                      (`core-rules.md`). Offered on the adventurers' side only, in round 1 only,
                      and only to whoever owns the combatant — the player rolls their own die.

                      A failure marks the row AND ticks its action mark — 2e says the PC loses
                      their turn, so there is nothing left for them to do this round. The tick is
                      still the owner's to undo if the Warden rules otherwise. --}}
                {{#if @root.isFirstRound}}
                    <div class="cairn-combat-dex">
                        {{#if dexSave}}
                            <i class="cairn-combat-dex-mark fa-solid {{#if (eq dexSave "passed")}}fa-bolt{{else}}fa-ban{{/if}}"
                               data-tooltip aria-label="{{localize (concat "CAIRN.Combat.DexSave." dexSave)}}"></i>
                        {{else if isOwner}}
                            {{!-- Worded, not a bare die: it is the one thing round one asks of
                                  the player, and a glyph among glyphs read as decoration. --}}
                            {{#if isAdventurer}}
                                <button type="button" class="cairn-combat-dex-roll" data-action="rollDexSave"
                                        data-tooltip-text="{{localize "CAIRN.Combat.DexSavePrompt"}}">{{localize "CAIRN.Combat.DexSaveButton"}}</button>
                            {{/if}}
                        {{/if}}
                    </div>
                {{/if}}

                {{!-- Morale, on every opponent and at any moment. The system whispers the Warden
                      a reminder when a trigger is crossed (`CairnCombat#remindMorale`), but this
                      never waits for it: who saves, and why, is the Warden's call. --}}
                {{#if @root.user.isGM}}
                    {{#unless isAdventurer}}
                        <div class="cairn-combat-morale-roll">
                            <button type="button" class="inline-control combatant-control icon fa-solid fa-flag"
                                    data-action="rollMorale" data-tooltip
                                    aria-label="{{localize "CAIRN.Combat.MoralePrompt"}}"></button>
                        </div>
                    {{/unless}}
                {{/if}}

                {{!-- The action mark: the same upright switch as an exploration's narrated mark
                      (maintainer's call, 2026-10-25) — it is the row's one recurring control, and
                      a 16px check among core's glyphs was hard to hit. A `<button role="switch">`
                      because core's `activateCombatant` pans to the token on any click in the row
                      that is not on an input or a button. Everyone sees whose action is spent;
                      only the owner sets it. --}}
                <div class="cairn-combat-acted">
                    <button type="button" class="cairn-switch cairn-acted-switch" role="switch"
                            aria-checked="{{#if resolved}}true{{else}}false{{/if}}"
                            data-action="toggleResolved" data-tooltip
                            aria-label="{{localize (ifThen resolved "CAIRN.Combat.ActedUndo" "CAIRN.Combat.Acted")}}"
                            {{#unless isOwner}}disabled{{/unless}}>
                        <span class="cairn-switch-track"><span class="cairn-switch-knob"></span></span>
                    </button>
                </div>
            </li>
        {{/each}}
    {{/each}}
    {{/if}}
</ol>
