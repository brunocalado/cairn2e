{{!-- The tracker's header: encounter selector, encounter name, round label and the context menu.

      Core's header also puts Roll All and Roll NPC beside the round label. Both roll
      `CONFIG.Combat.initiative` into `combatant.initiative`, and 2e has no initiative: the order
      is fixed by side (`core-rules.md` → Combat → Rounds), and the only opening roll — each PC's
      first-round DEX save — lives on the row itself. The two spacers keep the label centred
      against the menu on the right, as core's non-GM branch already does. Everything else is
      core's markup, so its layout and its actions still apply.

      Beside core's "+" sits the Warden's way into a dungeon exploration, and an exploration
      counts turns rather than rounds (`procedures.md` → Dungeon Exploration). A rule parts the
      two that make an encounter from the ones that switch between them, and an exploration's
      number wears the same dungeon glyph as the button that made it.

      Every encounter is always a numbered tab, however many there are: past what one line holds
      the numbers wrap onto a second, between the create buttons and the gear. Core's ◀ n/m ▶
      past seven hid every encounter but one behind two arrows (maintainer's call, 2026-10-17). --}}
<header class="combat-tracker-header">

    {{#if user.isGM}}
    <nav class="encounters {{ css }}" aria-label="{{ localize "COMBAT.NavLabel" }}">

        {{#if combats.length}}
        <button type="button" class="inline-control icon fa-solid fa-plus" data-action="createCombat"
                data-tooltip aria-label="{{ localize "COMBAT.Create" }}"></button>
        <button type="button" class="inline-control icon fa-solid fa-dungeon" data-action="createDungeon"
                data-tooltip aria-label="{{ localize "CAIRN.Dungeon.Create" }}"></button>
        <span class="cairn-encounters-rule" aria-hidden="true"></span>
        <div class="cairn-encounter-tabs">
            {{#each combats}}
            <button type="button" class="inline-control {{#if active}}active{{/if}}" data-action="cycleCombat"
                    data-combat-id="{{ id }}"
                    {{#if name}}data-tooltip aria-label="{{name}}"{{else if isDungeon}}data-tooltip aria-label="{{ localize "CAIRN.Dungeon.Exploration" n=label }}"{{/if}}>
                {{#if isDungeon}}<i class="fa-solid fa-dungeon cairn-encounter-kind" inert></i>{{/if}}{{ label }}
            </button>
            {{/each}}
        </div>
        <button type="button" class="inline-control icon fa-solid fa-gear" data-action="trackerSettings"
                data-tooltip aria-label="{{ localize "COMBAT.Settings" }}"></button>

        {{else}}
        <button type="button" class="combat-control-lg" data-action="createCombat">
            <i class="fa-solid fa-plus" inert></i>
            <span>{{ localize "COMBAT.Create" }}</span>
        </button>
        <button type="button" class="combat-control-lg" data-action="createDungeon">
            <i class="fa-solid fa-dungeon" inert></i>
            <span>{{ localize "CAIRN.Dungeon.Create" }}</span>
        </button>
        {{/if}}
    </nav>
    {{/if}}

    {{#if combat.name}}
    <h2 class="encounter-name">{{ combat.name }}</h2>
    {{/if}}

    <div class="encounter-controls {{#if hasCombat}}combat{{/if}}">
        {{!-- An exploration's help mark takes the first spacer's place, for everyone: the players
              are the ones who need the cycle explained, and the label stays centred. --}}
        <div class="control-buttons left flexrow">
            {{#if isDungeon}}
            {{> "systems/cairn2e/templates/parts/help-mark.hbs" tip="CAIRN.Dungeon.Help"
                label=(localize "CAIRN.Dungeon.HelpLabel") seed="dungeon" action="openRules"}}
            {{else}}
            <div class="spacer"></div>
            {{/if}}
            <div class="spacer"></div>
        </div>

        <strong class="encounter-title">
            {{#if combats.length}}
            {{#if isDungeon}}
            {{#if combat.round}}
            {{ localize "CAIRN.Dungeon.Turn" turn=combat.round }}
            {{else}}
            {{ localize "CAIRN.Dungeon.NotStarted" }}
            {{/if}}
            {{else if combat.round}}
            {{ localize "COMBAT.Round" round=combat.round }}
            {{else}}
            {{ localize "COMBAT.NotStarted" }}
            {{/if}}
            {{else}}
            {{ localize "COMBAT.None" }}
            {{/if}}
        </strong>

        <div class="control-buttons right flexrow">
            <div class="spacer"></div>
            <button type="button" class="encounter-context-menu inline-control combat-control icon fa-solid fa-ellipsis-vertical"
                    {{#unless (and user.isGM hasCombat)}}disabled{{/unless}}></button>
        </div>
    </div>

</header>
