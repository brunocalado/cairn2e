{{!-- A dungeon exploration's rows, drawn inside the tracker's one `<ol>` (the part may produce a
      single top-level element, so everything here is an `<li>`).

      `procedures.md` → Dungeon Exploration Cycle: the Warden describes, the players declare their
      intended movements and actions, the Warden resolves them. So each row carries what its
      player declared — free text, the SRD's actions offered in a list with their rules and never
      required — how far the token moved this turn, and an acted switch for the same flag a fight's row ticks.
      Nothing here stops anyone doing anything. --}}
<li class="cairn-combat-side is-active">{{localize "CAIRN.Dungeon.Party"}}</li>

{{#each dungeon.rows}}
    <li class="combatant cairn-dungeon-row {{css}} {{#if resolved}}is-resolved{{/if}}"
        data-combatant-id="{{id}}" data-action="activateCombatant">

        <img class="token-image" src="{{img}}" alt="{{name}}" loading="lazy">

        {{!-- One grid, two lines: the name with this turn's distance, then the declaration. The
              last column is a 20px slot on both lines — the undo above, the action list below —
              kept even when it is empty, so every row's distance, field and glyphs sit in the same
              columns whoever owns it and whether or not it has moved. --}}
        <div class="token-name cairn-dungeon-body">
            <strong class="name">{{name}}</strong>

            {{!-- The pace is a hue — within torchlight, past it, past the three torchlights an
                  action covers — and past torchlight a glyph as well, so it never rests on colour
                  alone. --}}
            <span class="cairn-dungeon-moved {{#if pace}}is-{{pace}}{{/if}}" data-tooltip
                  aria-label="{{localize paceLabel}}">
                {{#if beyondTorch}}<i class="fa-solid fa-person-running" inert></i>{{/if}}{{moved}}&nbsp;{{units}}
            </span>

            {{!-- Back to where the token stood when the turn began: core's recorded-movement undo,
                  for whoever owns the token — its player on their own row, the Warden on every row. --}}
            <span class="cairn-dungeon-slot is-undo">
                {{#if canRevert}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-rotate-left"
                            data-action="revertMovement" data-tooltip
                            aria-label="{{localize "CAIRN.Dungeon.RevertMovement"}}"></button>
                {{/if}}
            </span>

            <input type="text" class="cairn-declared" name="declared.{{id}}" value="{{declared}}"
                   autocomplete="off"
                   placeholder="{{localize "CAIRN.Dungeon.DeclarePlaceholder"}}"
                   aria-label="{{localize "CAIRN.Dungeon.DeclareLabel" name=name}}"
                   {{#unless isOwner}}disabled{{/unless}}>

            <span class="cairn-dungeon-slot is-list">
                {{#if isOwner}}
                    <button type="button" class="inline-control combatant-control icon fa-solid fa-list {{#if choosing}}active{{/if}}"
                            data-action="toggleDungeonActions" data-tooltip aria-expanded="{{#if choosing}}true{{else}}false{{/if}}"
                            aria-label="{{localize "CAIRN.Dungeon.ChooseAction"}}"></button>
                {{/if}}
            </span>
        </div>

        {{!-- The acted mark is the system's toggle (Primitive 5), not a bare glyph: a pill with a
              shape of its own reads as this row's, where a lone check floated in the column. It
              is a `<button role="switch">` wearing the toggle's track and knob rather than the
              partial's label and checkbox, because core's `activateCombatant` selects and pans to
              the token on any click in the row that is not on an input or a button — the label's
              track is neither. Everyone sees the state; only the owner can flip it. --}}
        <div class="cairn-combat-acted">
            <button type="button" class="cairn-switch cairn-acted-switch" role="switch"
                    aria-checked="{{#if resolved}}true{{else}}false{{/if}}"
                    data-action="toggleResolved" data-tooltip
                    aria-label="{{localize (ifThen resolved "CAIRN.Dungeon.ActedUndo" "CAIRN.Dungeon.Acted")}}"
                    {{#unless isOwner}}disabled{{/unless}}>
                <span class="cairn-switch-track"><span class="cairn-switch-knob"></span></span>
            </button>
        </div>
    </li>

    {{!-- The open action list: each action's name and its rule line, readable without a hover.
          A sibling of the row rather than inside it, where every click would also reach the
          row's own `activateCombatant`. --}}
    {{#if choosing}}
        <li class="cairn-dungeon-actions" data-combatant-id="{{id}}">
            <ul class="plain">
                {{#each actions}}
                    <li>
                        <button type="button" data-action="chooseDungeonAction" data-key="{{key}}">
                            <strong>{{label}}</strong> <span>{{rule}}</span>
                        </button>
                    </li>
                {{/each}}
            </ul>
        </li>
    {{/if}}
{{/each}}

{{!-- The Warden's side: when the SRD says to roll, and the roll. The four triggers are
      reminders, never a gate — "If appropriate, the Warden should roll … Keep common sense in
      mind". The one the client can see for itself, a token past torchlight, is drawn in full
      ink; the other three need a judgement no document holds. --}}
{{#if dungeon.warden}}
    <li class="cairn-dungeon-warden">
        {{!-- A fight breaks out: a second combat with the party already in it. This exploration
              stays as it is and becomes the active one again when that fight is deleted. --}}
        <button type="button" class="cairn-dungeon-fight" data-action="startFight">
            <i class="fa-solid fa-swords" inert></i>{{localize "CAIRN.Dungeon.Fight"}}
        </button>
        <p class="cairn-dungeon-when">{{localize "CAIRN.Dungeon.When"}}</p>
        <ul class="cairn-dungeon-triggers plain">
            {{#each dungeon.triggers}}
                <li class="{{#if lit}}is-lit{{/if}}">{{label}}</li>
            {{/each}}
        </ul>
        <button type="button" class="cairn-dungeon-roll" data-action="rollDungeonEvent">
            <i class="fa-solid fa-dice-d6" inert></i>{{localize "CAIRN.Dungeon.RollEvent"}}
        </button>

        {{!-- The event drawn this turn, until the turn changes. Exhaustion is the one row that
              writes to the sheets, and only when the Warden presses the party's choice. --}}
        {{#if dungeon.event}}
            <div class="cairn-dungeon-event">
                <strong>{{dungeon.event.name}}</strong> {{dungeon.event.text}}
            </div>
            {{#if dungeon.event.exhaustion}}
                <div class="cairn-dungeon-exhaustion">
                    <button type="button" data-action="exhaustionFatigue">{{localize "CAIRN.Dungeon.AddFatigue"}}</button>
                    <button type="button" data-action="exhaustionRation">{{localize "CAIRN.Dungeon.EatRation"}}</button>
                </div>
            {{/if}}
        {{/if}}
    </li>
{{/if}}
