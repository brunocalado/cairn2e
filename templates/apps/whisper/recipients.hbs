{{!-- Who hears it: every connected user but the one writing, one list row each. Picked is said
      with ink, never with a hue — the mark at the head of the row inverts to paper on ink, the way
      a chosen Scars row's number does. A click sets the mark in place and redraws nothing, so what
      is being written below is never lost to it. --}}
<section class="cairn-whisper-to">
    <h3 class="cairn-edit-group" data-ink="hline" data-ink-seed="whisper-to" data-ink-w="1.8" data-ink-at="bottom">
        {{localize "CAIRN.Whisper.To"}}
    </h3>
    <ol class="cairn-plain-list cairn-whisper-users">
        {{#each users as |u|}}
        <li class="cairn-slot cairn-whisper-user{{#if u.picked}} selected{{/if}}" data-action="whisperPick"
            data-user-id="{{u.id}}" role="button" aria-pressed="{{#if u.picked}}true{{else}}false{{/if}}"
            {{#unless @last}}data-ink="hline" data-ink-seed="whisper-user-{{@index}}" data-ink-w="0.9" data-ink-a="0.42" data-ink-at="bottom"{{/unless}}>
            <span class="cairn-whisper-mark"><i class="fa-solid fa-check" inert></i></span>
            <span class="cairn-item-title">{{u.name}}</span>
            {{#if u.isGM}}<span class="cairn-item-tag">{{localize "CAIRN.Whisper.Warden"}}</span>{{/if}}
        </li>
        {{else}}
        <li class="cairn-empty">{{localize "CAIRN.Whisper.NobodyOnline"}}</li>
        {{/each}}
    </ol>
</section>
