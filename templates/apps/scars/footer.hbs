{{!-- What the button will roll, then what it rolled, then the button.

      Before: one sentence of what the row rolls now, and whether its gain waits. After: one line
      per effect — a condition, the save, the gain or the gain still owed — each with the dice
      that decided it, written in as its die lands. The window stays open on the result until the
      player closes it: a window that shut itself on the click was a maximum that moved unseen. --}}
<footer class="cairn-scars-foot">
    {{#if preview}}
    <p class="cairn-scars-note">{{preview}}</p>
    {{/if}}
    {{#if deferredNote}}
    <p class="cairn-scars-note">{{localize 'CAIRN.Scar.Deferred'}}</p>
    {{/if}}
    {{#if lines.length}}
    <ul class="cairn-plain-list cairn-scars-lines">
        {{#each lines as |l|}}
        <li class="cairn-scars-line {{l.tone}}{{#if l.fresh}} fresh{{/if}}"
            {{#unless @last}}data-ink="hline" data-ink-seed="scar-line-{{@index}}" data-ink-w="0.9" data-ink-a="0.42" data-ink-at="bottom"{{/unless}}>
            <span class="cairn-scars-line-label">{{l.label}}</span>
            <span class="cairn-scars-line-value">{{l.value}}</span>
            {{#if l.dice}}<span class="cairn-scars-line-dice">{{l.dice}}</span>{{/if}}
        </li>
        {{/each}}
    </ul>
    {{/if}}
    <div class="cairn-scars-buttons">
        {{#if ready}}
        <button type="button" data-action="scarRoll"><i class="fa-solid fa-dice" inert></i> {{localize buttonLabel}}</button>
        {{/if}}
        {{#if rolling}}
        <p class="cairn-scars-note">{{localize 'CAIRN.Scar.Rolling'}}</p>
        {{/if}}
        {{#if done}}
        <button type="button" data-action="scarDone">{{localize 'CAIRN.Scar.Done'}}</button>
        {{/if}}
    </div>
</footer>
