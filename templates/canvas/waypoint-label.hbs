{{!-- Core's templates/hud/waypoint-label.hbs with the system's figures. Its classes are core's,
      so core's stylesheet draws it; when core's template changes, compare. --}}
<div class="waypoint-label {{cssClass}}">
    {{#if action.img}}
    <div class="img" style="background-image: url('{{ action.img }}');"></div>
    {{else if action.icon}}
    <i class="icon {{action.icon}}"></i>
    {{else if action.label}}
    <label class="action-label">{{localize action.label}}</label>
    {{/if}}
    <span class="total-measurement">{{measure.total}}</span>
    {{#if measure.delta}}
    <span class="delta-measurement">({{measure.delta}})</span>
    {{/if}}
    {{#if (and elevation (not elevation.hidden))}}
    <i class="icon {{elevation.icon}}"></i>
    <span class="total-elevation">{{measure.elevation}}</span>
    {{#if measure.rise}}
    <span class="delta-elevation">({{measure.rise}})</span>
    {{/if}}
    {{/if}}
    {{#if secret}}
    <i class="icon fa-solid fa-eye-slash"></i>
    {{/if}}
</div>
