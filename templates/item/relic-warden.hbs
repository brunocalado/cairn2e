{{!-- The Warden's alone, on a relic: whether its holder knows what it is
      (`knowledge-and-perception.md` → Relics). While they do not, it goes by the name and the
      appearance written here — what they call it and what they can see; its picture stays,
      because what it looks like is never the mystery. Reveal is in the title bar's menu. --}}
<h4 class="cairn-zone">{{localize 'CAIRN.Relic.Zone'}}</h4>
<div class="cairn-zone-rule" data-ink="hline" data-ink-seed="zone-relic-warden" data-ink-w="1" data-ink-a="0.34"></div>
<div class="cairn-prop-list">
    <div class="cairn-field cairn-prop-row"
        {{#if system.unknown}}data-ink="hline" data-ink-at="bottom" data-ink-w="0.9" data-ink-a="0.42" data-ink-seed="gear-unknown"{{/if}}>
        <span class="cairn-prop-label">
            <label for="gear-unknown-{{item.id}}">{{localize 'CAIRN.Relic.UnknownLabel'}}</label>
            {{> "systems/cairn2e/templates/parts/help-mark.hbs" tip="CAIRN.Relic.UnknownHint"
                label=(localize 'CAIRN.Relic.UnknownHint') seed="relic-unknown"}}
        </span>
        {{> "systems/cairn2e/templates/parts/toggle.hbs" field="system.unknown" value=system.unknown
            id=(concat "gear-unknown-" item.id)}}
    </div>
    {{#if system.unknown}}
    <div class="cairn-field cairn-prop-row">
        <label for="gear-guise-{{item.id}}">{{localize 'CAIRN.Relic.GuiseName'}}</label>
        <input id="gear-guise-{{item.id}}" type="text" name="system.guiseName" value="{{system.guiseName}}"
            placeholder="{{localize 'CAIRN.Relic.Unknown'}}" />
    </div>
    {{/if}}
</div>
{{#if system.unknown}}
<div class="cairn-prose-box cairn-relic-guise" data-ink="box" data-ink-seed="relic-guise" data-ink-w="1.6">
    <prose-mirror name="system.guiseDescription" value="{{system.guiseDescription}}" toggled
        data-document-uuid="{{item.uuid}}" {{#unless editable}}disabled{{/unless}}>{{{guiseHTML}}}</prose-mirror>
</div>
{{/if}}
