{{!-- As the item's description is (`templates/item/tab-description.hbs`, which has the whole
      finding): for whoever may edit it, a `<prose-mirror>` that is always open — click and type,
      saved on leaving the field — and for a reader the enriched text, links live. --}}
<section class="tab {{tabs.recharge.cssClass}}" data-group="primary" data-tab="recharge">
    <div class="cairn-prose-box" data-ink="box" data-ink-seed="item-recharge" data-ink-w="1.6">
        {{#if editable}}
        <prose-mirror name="system.recharge" value="{{system.recharge}}"
            data-document-uuid="{{item.uuid}}"></prose-mirror>
        {{else}}
        <div class="editor-content">{{{rechargeHTML}}}</div>
        {{/if}}
    </div>
</section>
