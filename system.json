{
  "id": "cairn2e",
  "title": "Cairn 2e",
  "description": "Cairn Second Edition for Foundry VTT. A rules-faithful implementation of the Cairn 2e SRD by Yochai Gal — background-driven character creation, roll-under saves, ten inventory slots, Panic, and the 2e bestiary.",
  "version": "0.0.1",
  
  "compatibility": {
    "minimum": "14",
    "verified": "14.368"
  },
  
  "authors": [
    {
      "name": "Mestre Digital",
      "url": "https://www.youtube.com/c/MestreDigital"
    }
  ],
  
  "socket": true,
  "esmodules": [
    "module/cairn2e.js"
  ],
  "styles": [
    { "src": "css/cairn2e.min.css" }
  ],
  "documentTypes": {
    "Actor": {
      "character": {},
      "npc": { "htmlFields": ["description"] },
      "party": {}
    },
    "Item": {
      "gear": { "htmlFields": ["description", "recharge"] },
      "coin": { "htmlFields": ["description"] },
      "fatigue": { "htmlFields": ["description"] },
      "background": { "htmlFields": ["description"] },
      "feature": { "htmlFields": ["description"] },
      "scar": { "htmlFields": ["description"] },
      "growth": { "htmlFields": ["description"] }
    },
    "JournalEntryPage": {
      "route": { "htmlFields": ["description"] },
      "faction": { "htmlFields": ["description"] }
    }
  },
  "packs": [
    {
      "name": "character-traits",
      "label": "Character Traits",
      "banner": "systems/cairn2e/assets/compendium-banner.webp",
