  "packFolders": [
    {
      "name": "Cairn 2e",
      "sorting": "m",
      "packs": ["macros"],
      "folders": [
        {
          "name": "Character Creation",
          "sorting": "m",
          "color": "#6e5a3c",
          "packs": ["backgrounds", "background-tables", "background-gear", "character-traits", "bonds", "omens"]
        },
        {
          "name": "Equipment",
          "sorting": "m",
          "color": "#4a5a52",
          "packs": ["gear", "weapons", "armor"]
        },
        {
          "name": "Magic",
          "sorting": "m",
          "color": "#4b3f63",
          "packs": ["spellbooks", "scrolls", "relics"]
        },
        {
          "name": "Reference",
          "sorting": "m",
          "color": "#3f5670",
          "packs": ["tables", "bestiary", "hirelings"]
        },
        {
          "name": "Warden",
          "sorting": "m",
          "color": "#6e1414",
          "packs": ["warden"]
        },
        {
          "name": "Homebrew",
          "sorting": "m",
          "color": "#5c5c5c",
          "packs": ["more-gear", "more-spellbooks", "more-scrolls"]
        }
      ]
    }
  ],
  "relationships": {
    "recommends": [
      {
        "id": "dice-so-nice",
        "type": "module",
        "manifest": "https://gitlab.com/riccisi/foundryvtt-dice-so-nice/-/raw/master/module/module.json",
        "compatibility": { "minimum": "6.3.0", "verified": "6.3.0" },
        "reason": "Rolls the system's own 3D Cairn d20 (assets/dice/cairn-d20.glb)."
      },
      {
        "id": "light-sources",
        "type": "module",
        "manifest": "https://raw.githubusercontent.com/brunocalado/light-sources/refs/heads/main/module.json",
        "compatibility": { "minimum": "0.0.9", "verified": "0.0.9" },
        "reason": "Lights a Torch, Lantern, Candle Helmet or Lightsucker Candle from the Token HUD and spends its uses; lights Illuminate when it is cast."
      }
    ]
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["css", "templates", "lang"]
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "grid": {
    "type": 1,
    "distance": 5,
    "units": "ft",
    "diagonals": 4
  },
  "primaryTokenAttribute": "hp",
  "secondaryTokenAttribute": "abilities.STR",
  "url": "https://github.com/brunocalado/cairn2e",
  "license": "LICENSE",
  "readme": "README.md",
  "bugs": "https://github.com/brunocalado/cairn2e/issues",
  "changelog": "CHANGELOG.md",
  "manifest": "https://github.com/brunocalado/cairn2e/releases/latest/download/system.json",
  "download": "https://github.com/brunocalado/cairn2e/releases/latest/download/cairn2e.zip",
  
  "background": "systems/cairn2e/assets/background.webp"
  
}
